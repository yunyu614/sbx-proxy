{
 "log": {
  "level": "info",
  "timestamp": true,
  "output": "/data/adb/sbx/log/sing-box.log"
 },
 "dns": {
  "servers": [
   {
    "type": "udp",
    "tag": "agh",
    "server": "__AGH_HOST__",
    "server_port": __AGH_PORT__
   },
   {
    "type": "udp",
    "tag": "direct",
    "server": "223.5.5.5"
   }
  ],
  "final": "agh"
 },
 "inbounds": [
  {
   "type": "tun",
   "tag": "tun-in",
   "address": [
    "172.19.0.1/30"
   ],
   "mtu": 9000,
   "auto_route": true,
   "auto_redirect": true,
   "strict_route": false
  }
 ],
 "outbounds": [
  {
   "type": "selector",
   "tag": "proxy",
   "outbounds": [
    "direct"
   ],
   "default": "direct"
  },
  {
   "type": "direct",
   "tag": "direct"
  }
 ],
 "route": {
  "rules": [
   {
    "action": "sniff",
    "timeout": "300ms"
   },
   {
    "protocol": "dns",
    "action": "hijack-dns"
   },
   {
    "domain_suffix": [
     "connect.rom.miui.com",
     "connectivitycheck.gstatic.com",
     "connectivitycheck.android.com"
    ],
    "outbound": "direct"
   },
   "__APP_RULES__",
   "__DIRECT_RULES__",
   {
    "ip_is_private": true,
    "outbound": "direct"
   }
  ],
  "final": "__ROUTE_FINAL__",
  "auto_detect_interface": true,
  "default_domain_resolver": {
   "server": "agh"
  },
  "rule_set": [
   {
    "type": "local",
    "tag": "geosite-cn",
    "format": "binary",
    "path": "/data/adb/sbx/rules/geosite-cn.srs"
   },
   {
    "type": "local",
    "tag": "geoip-cn",
    "format": "binary",
    "path": "/data/adb/sbx/rules/geoip-cn.srs"
   }
  ]
 },
 "experimental": {
  "clash_api": {
   "external_controller": "127.0.0.1:39090"
  }
 }
}